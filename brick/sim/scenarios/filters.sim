# Shelf filters: SELECT steps each shelf through A–Z, LAST PLAYED, MOST PLAYED, then the
# offline rankings' TOP 100, POPULAR, BEST SELLING and FIRST PARTY, skipping any with no games.
# The pill in the top corner names the filter; ranked filters number the title card.
phase SetClock
wait 2000
press a
phase Shelf
wait 2000
snap gba-az
press select
wait 1500
press select
wait 1500
press select
wait 700
snap gba-top100
press right
wait 600
snap gba-top100-next
press select
wait 700
snap gba-popular
press select
wait 700
snap gba-best-selling
press select
wait 700
snap gba-first-party
press select
wait 1500
# L1 from the first shelf wraps round to the last one: Arcade.
press l1
wait 2000
snap arcade-az
press select
wait 1500
press select
wait 1500
press select
wait 700
snap arcade-top100
press select
wait 700
snap arcade-popular
press select
wait 700
snap arcade-back-to-az
